{
  "name": "chrislamberthdev",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "lint": "eslint .",
    "typegen": "sanity schema extract --path .sanity/schema.json --force && sanity typegen generate && node -e \"const fs = require('node:fs'); const file = '../frontend/src/lib/sanity.types.ts'; fs.writeFileSync(file, fs.readFileSync(file, 'utf8').trimEnd() + '\\n')\""
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "overrides": {
    "@oclif/core": {
      "minimatch": "11.0.9"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.9"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    }
  }
}
